{
  "expo": {
    "name": "Infoon TV",
    "slug": "android-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "androidtv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.infoon.tv",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FB923C"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,

      "permissions": ["INTERNET"]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
          "expo-splash-screen",
          {
            "image": "./assets/images/splash-landscape.png",
            "imageWidth": 420,
            "resizeMode": "contain",
            "backgroundColor": "#000000",
            "dark": {
              "backgroundColor": "#000000"
            }
          }
      ],

      "expo-video",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}