{
  "expo": {
    "name": "Infoon TV",
    "slug": "android-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "androidtv",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.infoon.tv",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "INTERNET"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf12677d-cf14-436c-8a1a-c2b4de125fd9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/bf12677d-cf14-436c-8a1a-c2b4de125fd9"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  }
}
